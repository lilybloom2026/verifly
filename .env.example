# VERIFLY environment. Copy to `.env.local` and edit.
#
# DATABASE_URL is OPTIONAL. Leave it unset and the app uses a zero-config
# in-memory store (works out of the box; not durable across restarts).
#
# For a durable registry, start Postgres with `docker compose up -d` and set:
# DATABASE_URL=postgres://verifly:verifly@localhost:5432/verifly

# Managed Postgres (Neon, Supabase, RDS…) that requires SSL:
# DATABASE_SSL=true

# Buy button. Set this to your token or DEX link to show the green
# "Buy $VERIFLY" button in the header. Leave it unset and the button is hidden.
# Must start with NEXT_PUBLIC_ so the browser can read it. Restart dev after changing.
NEXT_PUBLIC_BUY_URL=https://pump.fun/coin/6eqx4Y3XrmDeMiciod31msH4jPd6ABRKTu2D4HYpump?highlight_callout=7e930812-a9f2-48f5-8e2d-1a36c0e66847
